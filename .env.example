# Copia este archivo a .env.local y llena los valores.
# La app solo necesita DOS cosas para funcionar: una base de datos y un
# secreto de sesión.

# --- Base de datos (obligatorio) ---
# Cadena de conexión a Postgres. En Railway: servicio Postgres → Variables.
# Dentro de Railway usa la URL de red privada; desde tu equipo, la del proxy TCP.
DATABASE_URL=postgresql://usuario:contrasena@host:5432/postgres
# Solo si el Postgres exige TLS (no hace falta en la red privada de Railway).
# DATABASE_SSL=require
# Conexiones máximas del pool (por instancia de la app).
# DATABASE_POOL_MAX=10

# --- Sesión (obligatorio) ---
# Firma la cookie de sesión. Mínimo 32 caracteres.
# Genéralo con: openssl rand -base64 48
# Si lo cambias, todas las sesiones abiertas se cierran.
AUTH_SECRET=CAMBIA-ESTO-POR-UN-SECRETO-LARGO-Y-ALEATORIO

# --- Imágenes ---
# Carpeta donde se guardan logos y fotos. En Railway debe ser la ruta de
# montaje de un volumen del servicio `app`, o los archivos se pierden en
# cada despliegue. En desarrollo, si se omite, usa ./.media
MEDIA_ROOT=/var/lib/alv-media

# --- URL pública del sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mercado Pago (checkout + webhook) ---
MP_ACCESS_TOKEN=TU-ACCESS-TOKEN-MP
# Clave secreta del webhook (Tus integraciones → Webhooks) para validar x-signature.
MP_WEBHOOK_SECRET=TU-CLAVE-SECRETA-WEBHOOK-MP

# --- Web Push (genera el par con: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=TU-VAPID-PUBLIC-KEY
VAPID_PRIVATE_KEY=TU-VAPID-PRIVATE-KEY
VAPID_SUBJECT=mailto:admin@alvsport.mx

# Secreto compartido con los triggers de la base (header x-alv-webhook-secret).
# Debe coincidir con la fila 'webhook_secret' de la tabla app_config.
WEBHOOK_SECRET=UN-SECRETO-LARGO-ALEATORIO

# Las cronicas de partido son automaticas y deterministas (sin IA): se arman
# desde los datos reales del juego. No requieren ninguna API key.
